# ─── AppsDeddy .htaccess ─────────────────────────────────────────────────────
# Apache configuration for security, performance, and clean URLs
# Deploy to Hostinger root (public_html)

# ─── Enable Rewrite Engine ───────────────────────────────────────────────────
RewriteEngine On
RewriteBase /

# WordPress /blog — never apply main-site PHP rewrites (must stay first)
RewriteRule ^blog(/.*)?$ - [L]

# ─── Nested routes (services, industries, case studies, technologies, insights)
RewriteRule ^services/([a-z0-9-]+)/?$ route.php?type=services&slug=$1 [L,QSA]
RewriteRule ^industries/([a-z0-9-]+)/?$ route.php?type=industries&slug=$1 [L,QSA]
RewriteRule ^case-studies/([a-z0-9-]+)/?$ route.php?type=case-studies&slug=$1 [L,QSA]
RewriteRule ^technologies/([a-z0-9-]+)/?$ route.php?type=technologies&slug=$1 [L,QSA]
RewriteRule ^insights/([a-z0-9-]+)/?$ route.php?type=insights&slug=$1 [L,QSA]
RewriteRule ^markets/([a-z0-9-]+)/?$ route.php?type=markets&slug=$1 [L,QSA]
RewriteRule ^case-studies/?$ case-studies.php [L]
RewriteRule ^industries/?$ industries.php [L]
RewriteRule ^technologies/?$ technologies.php [L]
RewriteRule ^insights/?$ insights.php [L]
RewriteRule ^markets/?$ markets.php [L]

# ─── Legacy service URLs → nested (301) ──────────────────────────────────────
RewriteRule ^gen-ai-integration/?$ services/ai-automation [R=301,L]
RewriteRule ^web-mobile-app-development/?$ services/custom-saas [R=301,L]
RewriteRule ^data-engineering-solutions/?$ services/data-engineering [R=301,L]
RewriteRule ^ux-ui-design/?$ services/ux-ui-design [R=301,L]

# XML sitemap
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ─── Force HTTPS ─────────────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── Remove www (redirect www to non-www) ────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# ─── Remove .php Extension (main site only, not /blog) ───────────────────────
RewriteCond %{REQUEST_URI} !^/blog [NC]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# ─── Redirect .php URLs to clean URLs (main site only) ───────────────────────
RewriteCond %{REQUEST_URI} !^/blog [NC]
RewriteCond %{REQUEST_URI} !^/includes/ [NC]
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# ─── Redirect old .html pages to clean URLs (main site only) ─────────────────
RewriteCond %{REQUEST_URI} !^/blog [NC]
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R=301]

# ─── Security & Performance Headers ────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ─── Protect sensitive PHP (main site root only — NOT WordPress /blog/) ─────
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|log|ini|env|json|lock|md)$">
        <If "%{REQUEST_URI} =~ m#^/blog(/|$)#">
            Require all granted
        </If>
        <Else>
            Require all denied
        </Else>
    </FilesMatch>

    <FilesMatch "^(index|contact|about|services|how-we-work|faq|testimonials|web-mobile-app-development|data-engineering-solutions|gen-ai-integration|ux-ui-design|privacy-policy|terms-conditions|cookie-policy|sitemap|404|route|case-studies|industries|technologies|insights|markets|thank-you|seo-checklist)\.php$">
        <If "%{REQUEST_URI} !~ m#^/blog/#">
            Require all granted
        </If>
    </FilesMatch>

    <FilesMatch "^mail-handler\.php$">
        Require all granted
    </FilesMatch>
</IfModule>

# Block access to includes directory (main site only)
RewriteCond %{REQUEST_URI} !^/blog [NC]
RewriteRule ^includes/(?!mail-handler\.php$) - [F,L]

# ─── Block Access to Hidden Files (.git, .env, etc) ─────────────────────────
RewriteRule (^\.|/\.) - [F]

# ─── Disable Directory Listing ───────────────────────────────────────────────
Options -Indexes

# ─── Set Default Character Set ───────────────────────────────────────────────
AddDefaultCharset UTF-8

# WebP MIME type
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

# ─── GZIP Compression ────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── Browser Caching ─────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-font-woff "access plus 1 year"
    ExpiresByType application/x-font-woff2 "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ─── Custom 404 (main site only — WordPress /blog handles its own errors) ───
RewriteCond %{REQUEST_URI} !^/blog [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(css|js|webp|png|jpg|jpeg|gif|svg|ico|woff2?)$ [NC]
RewriteRule ^ 404.php [L]

ErrorDocument 404 /404

# ─── PHP Settings (Hostinger Compatible) ─────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 60
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 1
    php_value session.use_strict_mode 1
</IfModule>
